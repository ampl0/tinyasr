    <!-- explainer -->
    <string name="how_it_works">How it works</string>
    <string name="about_text">
        <b>Audio file</b> — pick any file the phone can decode (m4a, mp3, ogg, wav, flac…).\n
        <b>Record</b> — capture a note, then transcribe it in full context.\n
        <b>Live</b> — captions as you speak; final words stay, the rest is replaced as it settles.\n
        <b>Share audio</b> — send an audio file to tinyasr from any app.\n
        <b>Phone speech engine</b> — select tinyasr in Settings → System → Languages → Speech, and every app that dictates uses it offline.\n\n
        Audio and text never leave this device. Models live in the app\'s private folder and survive updates.
    </string>
    <string name="stt_hint">Choose tinyasr in the list. Being installed is not enough — it has to be selected.</string>
    <string name="stt_manual">Open Settings → System → Languages → Speech and choose tinyasr</string>
