<?xml version="1.0" encoding="utf-8"?>
<!--
  Only text appearance and background live in these styles.

  Deliberately NO layout_width / layout_height / layout_weight: a Value in a
  <style> is unreliable for layout params (the platform reads them from the
  view's own attributes when it generates LayoutParams, and a missing width
  fails inflation with "You must supply a layout_width attribute"). Every view
  declares its own size attributes.
-->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
    </style>

    <style name="Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="SectionLabel" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/on_surface_muted</item>
    </style>

    <style name="Hint" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Button" parent="@android:style/Widget.Material.Button">
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
